{
  "name": "my-media-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Headless Media SDK & Component Library Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=web-app run dev",
    "build": "npm run build --workspaces --if-present",
    "check-types": "tsc --build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.3.3"
  }
}
