{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@my-media/core": ["./packages/media-core/dist/index.d.ts"],
      "@my-media/react": ["./packages/media-react/dist/index.d.ts"],
      "@my-media/native": ["./packages/media-native/dist/index.d.ts"],
      "@my-media/ui-react": ["./packages/media-ui-react/dist/index.d.ts"],
      "@my-media/ui-native": ["./packages/media-ui-native/dist/index.d.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}
